# Shared
PIT_TEAM_NUMBER=1895
TBA_KEY=your_tba_key_here
TBA_EVENT_KEY=2026mawor
INTEL_HMAC_SECRET=replace_with_long_random_secret

# Meshtastic serial
MESHTASTIC_PORT=COM5
MESHTASTIC_CHANNEL_INDEX=0

# Pit-side bridge
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8090
INTEL_MAX_AGE_SECONDS=900
TBA_REFRESH_SECONDS=30
BRIDGE_SIMULATOR_MODE=false
BRIDGE_SIMULATOR_INTERVAL_SECONDS=20

# Sender
LOVAT_API_KEY=your_lovat_api_key_here
# Expected to return JSON with an `opponents` array or a list of rows.
# Supported placeholders: {event_key} {match_key} {teams}
LOVAT_EXPORT_URL=https://your-lovat-export-endpoint?event={event_key}&match={match_key}&teams={teams}
INTEL_TRIGGER_MATCHES_BEFORE=2
INTEL_BURST_INTERVAL_SECONDS=20
INTEL_BURST_DURATION_SECONDS=120
INTEL_STEADY_INTERVAL_SECONDS=60
MESHTASTIC_MAX_PAYLOAD_BYTES=220
SENDER_POLL_SECONDS=10
SENDER_SIMULATOR_MODE=false
SENDER_SIMULATOR_NO_RADIO=false
